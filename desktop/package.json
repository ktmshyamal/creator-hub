{
  "name": "creator-hub-desktop",
  "version": "1.0.0",
  "description": "Creator Hub for Windows, Mac and Linux",
  "main": "main.js",
  "author": "Creator Hub",
  "scripts": {
    "prepare-app": "node prepare.js",
    "start": "node prepare.js && electron .",
    "dist": "node prepare.js && electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "33.2.0",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.creatorhub.desktop",
    "productName": "Creator Hub",
    "files": ["main.js", "app/**/*"],
    "directories": { "buildResources": "build", "output": "dist" },
    "win": { "icon": "build/icon.png", "target": "nsis" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true }
  }
}
